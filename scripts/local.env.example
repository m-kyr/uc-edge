# Copy to scripts/local.env (gitignored) and fill in. See scripts/signing.sh.
# A name from `security find-identity -v -p codesigning`, or - for ad-hoc signing.
UCEDGE_SIGN_IDENTITY='Apple Development: Jane Doe (ABCDE12345)'
# Optional: refuse a UCEdge.app build that would lose the permission grants. After your first
# build, uncomment and paste the designated requirement that build-app.sh prints
# (`codesign -d -r- build/UCEdge.app`), e.g.:
# UCEDGE_EXPECTED_DR='identifier "local.uc-edge" and anchor apple generic and certificate leaf[subject.CN] = "Apple Development: Jane Doe (ABCDE12345)"'
